# Copy to .env (git-ignored). Generate secrets with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
APP_BASE_URL=https://poll.example.org
VOTER_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true only when the app is reachable exclusively through Cloudflare (tunnel or proxied origin)
TRUST_CLOUDFLARE_HEADERS=true
DATABASE_PATH=./data/poll.db
POLL_CONFIG=./poll.toml
BACKUP_DIR=./backups
# Docker compose only: token of a remotely-managed tunnel whose public hostname
# points at http://app:8787
TUNNEL_TOKEN=
